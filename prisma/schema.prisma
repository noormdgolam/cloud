// Prisma schema for cloud.bongshai.com
// Prisma ORM 7 — uses the "prisma-client" generator + a driver adapter
// (@prisma/adapter-mariadb) rather than the old bundled query-engine binary.
// The database connection URL lives in prisma.config.ts / DATABASE_URL, not here.
//
// ID/FK columns are explicitly @db.VarChar(N) (tight lengths matching cuid()'s
// actual 25-char output, not Prisma's 191-char MySQL default) because this
// host's MySQL/MariaDB caps composite index key length at ~1000 bytes — a
// couple of default-width VARCHAR(191) utf8mb4 columns in the same index blows
// past that immediately. Every field below sized to keep every index safely
// under that ceiling.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // Prisma bundles a ~5MB WASM query compiler for EVERY SQL dialect
  // (postgresql/sqlite/sqlserver/cockroachdb) even though this project only
  // ever uses MariaDB via @prisma/adapter-mariadb — there's currently no
  // per-engine exclusion option (prisma/prisma#29095, acknowledged as a
  // known limitation). "small" shrinks all five compiled builds together;
  // it's the only lever available today. This mattered concretely: the
  // ~50MB of dead-weight WASM files were the direct cause of repeated
  // multi-minute FTP deploy stalls on this host.
  compilerBuild = "small"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid()) @db.VarChar(30)
  email         String    @unique @db.VarChar(191)
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String? // null for OAuth-only accounts

  usedBytes  BigInt  @default(0)
  quotaBytes BigInt? @default(26843545600) // 25 GiB; null = unlimited (superuser, granted manually)
  // Permanent additive storage from referrals + addon-pack purchases, tracked
  // separately from quotaBytes so activateSubscription can add it back in
  // instead of clobbering it when a plan sets quotaBytes directly.
  bonusBytes BigInt  @default(0)

  isAdmin Boolean @default(false) // grants access to /backstage — granted manually, never self-service

  // Creator-earnings program: 100% of ad revenue attributable to this
  // user's file views, in BDT poisha (matches Plan/Payment's currency
  // convention). Only ever moved by an admin ledger entry — never
  // computed/paid automatically, since real ad revenue isn't known in real time.
  creatorBalancePoisha Int     @default(0)
  // Explicit opt-in — ads only ever render on a share-link page when the
  // FILE OWNER has this set. Off by default for every account (including
  // paid plans and plain free accounts), so nobody sees an ad on a shared
  // file unless they specifically chose to trade that for a revenue share.
  creatorProgramEnabled Boolean @default(false)

  referralCode String? @unique @db.VarChar(12) // lazily generated on first view of the referral card, not at signup
  referredById String? @db.VarChar(30)
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  files              File[]
  folders            Folder[]
  shareLinks         ShareLink[]
  claimedFrom        AnonymousSession[]
  subscriptions      Subscription[]
  payments           Payment[]
  addonPurchases     AddonPurchase[]
  passwordResetCodes PasswordResetCode[]
  fileRequests       FileRequest[]
  creatorLedger      CreatorLedgerEntry[]
  reels              Reel[]
}

// Self-service "forgot password" flow — a short numeric code emailed to the
// account, distinct from Auth.js's own VerificationToken (that one is shaped
// for magic-link URLs, not a code the user types in).
model PasswordResetCode {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @db.VarChar(30)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @db.VarChar(191)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Auth.js Prisma-adapter shape — field names must not deviate.
model Account {
  id                String  @id @default(cuid()) @db.VarChar(30)
  userId            String  @db.VarChar(30)
  type              String
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(100)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @db.VarChar(30)
  sessionToken String   @unique @db.VarChar(64)
  userId       String   @db.VarChar(30)
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String   @db.VarChar(100)
  token      String   @unique @db.VarChar(100)
  expires    DateTime

  @@unique([identifier, token])
}

model AnonymousSession {
  id         String   @id @db.VarChar(48) // the raw random cookie value, not a cuid
  usedBytes  BigInt   @default(0)
  quotaBytes BigInt   @default(2147483648) // 2 GiB
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  claimedByUserId String? @db.VarChar(30)
  claimedByUser   User?   @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  files      File[]
  folders    Folder[]
  shareLinks ShareLink[]

  @@index([claimedByUserId])
}

model Folder {
  id       String  @id @default(cuid()) @db.VarChar(30)
  name     String
  parentId String? @db.VarChar(30)

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  userId String? @db.VarChar(30)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anonymousSessionId String?           @db.VarChar(48)
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files        File[]
  fileRequests FileRequest[]

  @@index([userId])
  @@index([anonymousSessionId])
  @@index([parentId])
}

enum FileStatus {
  RESERVED
  COMMITTED
  DELETED
  // Terminal, user-facing "gone forever" state — set instead of an actual
  // row/disk delete whenever a user empties trash or the 30-day auto-purge
  // fires. The disk blob and DB row are deliberately kept: superusers can
  // still browse and download PURGED files from /backstage, ordinary users
  // never see them again (every user-facing query filters to COMMITTED or
  // DELETED only).
  PURGED
}

// PENDING: submitted to VirusTotal, awaiting analysis (poll-virus-scans.ts
// resolves these). CLEAN/INFECTED: resolved verdict, from either an instant
// hash-lookup match or a completed analysis. ERROR: VirusTotal call failed
// (rate-limited, network, etc) — fails open, never blocks downloads. SKIPPED:
// default for rows that existed before this feature shipped, and for files
// too large to submit — never scanned, treated like CLEAN everywhere.
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  SKIPPED
}

enum ModerationStatus {
  UNSCANNED
  SAFE
  FLAGGED_ADULT
  FLAGGED_SUGGESTIVE
  ERROR
}

model File {
  id             String     @id @default(cuid()) @db.VarChar(30)
  storageKey     String     @unique @db.VarChar(36) // UUID used verbatim as the on-disk filename, no extension
  originalName   String
  mimeType       String
  size           BigInt // reconciled to real byte count post-upload
  status         FileStatus @default(RESERVED)
  checksumSha256 String?

  // Malware scan (VirusTotal). Defaults to SKIPPED so the ALTER TABLE that
  // adds this column doesn't retroactively queue every pre-existing file for
  // scanning — commitQuota() explicitly sets PENDING for newly uploaded
  // files going forward. scanAnalysisId is set only while a fresh (not
  // hash-known) file is awaiting VirusTotal's async analysis result.
  scanStatus     FileScanStatus @default(SKIPPED)
  scanAnalysisId String?        @db.VarChar(191)
  scanCheckedAt  DateTime?

  folderId String? @db.VarChar(30)
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  userId String? @db.VarChar(30)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anonymousSessionId String?           @db.VarChar(48)
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Dedup-gated count of share-link page loads (one per visitor per file
  // per 24h — see FileViewDedup) — the basis for the creator-earnings
  // program's per-file view stats.
  viewCount BigInt @default(0)

  shareLinks    ShareLink[]
  requestUpload FileRequestUpload?
  reel          Reel?
  moderation    FileModeration?

  @@index([userId, folderId, createdAt])
  @@index([anonymousSessionId, folderId, createdAt])
  @@index([userId, status, checksumSha256])
}

model FileModeration {
  id         String           @id @default(cuid()) @db.VarChar(30)
  fileId     String           @unique @db.VarChar(30)
  file       File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status     ModerationStatus @default(UNSCANNED)
  confidence Float?
  category   String?          @db.VarChar(64)
  reason     String?          @db.Text
  flaggedAt  DateTime?
  scannedAt  DateTime         @default(now())

  @@index([status, scannedAt])
}

// One row per (file, visitor, day) that has already been counted toward
// File.viewCount — presence = "don't increment again". Short-lived by
// design (expiresAt), purged the same way stale upload reservations are:
// opportunistically, not a hard requirement for correctness.
model FileViewDedup {
  key       String   @id @db.VarChar(191) // sha256(`${fileId}:${ip}`).slice(0, 40)
  expiresAt DateTime

  @@index([expiresAt])
}

model ShareLink {
  id    String @id @default(cuid()) @db.VarChar(30)
  token String @unique @db.VarChar(32) // crypto.randomBytes(18).toString('base64url')

  fileId String @db.VarChar(30)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  expiresAt     DateTime?
  maxDownloads  Int?
  downloadCount Int       @default(0)
  revoked       Boolean   @default(false)
  passwordHash  String?   @db.VarChar(191)

  createdByUserId String? @db.VarChar(30)
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdByAnonId String?           @db.VarChar(48)
  createdByAnon   AnonymousSession? @relation(fields: [createdByAnonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([fileId])
}

enum CreatorLedgerType {
  CREDIT // admin distributing a share of real, already-earned ad revenue
  PAYOUT // admin recording that a balance was actually paid out (e.g. via bKash)
}

// Manually-entered ledger for the creator-earnings program — never written
// by anything automatic. An admin adds a CREDIT after real ad revenue for a
// period is known (distributed pro-rata by view share), and a PAYOUT once
// they've actually sent the money. User.creatorBalancePoisha is the
// running sum, kept in sync by whatever writes an entry here.
model CreatorLedgerEntry {
  id     String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          CreatorLedgerType
  amountPoisha  Int
  note          String?           @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
}

// A video file the owner has explicitly published to the public /reels
// feed — publishing is a deliberate, per-file action (never automatic just
// from uploading), and only ever available to a user who has already
// opted into the creator-earnings program, since a reel's whole purpose is
// generating ad-eligible views. Unpublishing sets published=false rather
// than deleting the row, so the file itself is never touched either way.
model Reel {
  id     String @id @default(cuid()) @db.VarChar(30)
  fileId String @unique @db.VarChar(30)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String @db.VarChar(30)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption   String? @db.VarChar(500)
  published Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([published, createdAt])
  @@index([userId])
}

// A shareable "drop a file for me" link — the reverse of ShareLink. Visiting
// /request/[token] needs no account; anything they upload lands directly in
// the REQUESTING user's own storage (via reserveQuota({userId}), same as any
// other upload), counted against their quota, not a new anonymous session.
model FileRequest {
  id    String @id @default(cuid()) @db.VarChar(30)
  token String @unique @db.VarChar(32)

  userId String @db.VarChar(30)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String  @db.VarChar(191)
  message String? @db.Text

  folderId String? @db.VarChar(30)
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  maxFiles  Int?
  fileCount Int       @default(0)
  revoked   Boolean   @default(false)

  createdAt DateTime @default(now())

  uploads FileRequestUpload[]

  @@index([userId])
}

model FileRequestUpload {
  id        String      @id @default(cuid()) @db.VarChar(30)
  requestId String      @db.VarChar(30)
  request   FileRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String      @unique @db.VarChar(30)
  file      File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  uploaderName String? @db.VarChar(191) // optional, self-reported — not an account

  createdAt DateTime @default(now())

  @@index([requestId])
}

model RateLimitBucket {
  key         String   @id @db.VarChar(191) // `${ip}:${route}`
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// Paid storage tiers. Row-per-plan rather than an enum so pricing/quota can
// change without a migration — `active: false` retires a plan without
// breaking historical Subscription/Payment rows that reference it.
model Plan {
  id             String  @id @db.VarChar(30) // stable slug, e.g. "plan_100gb"
  name           String  @db.VarChar(100)
  quotaBytes     BigInt
  priceUsdCents  Int // canonical price, smallest USD unit
  priceBdtPoisha Int // BDT price, smallest unit (1 BDT = 100 poisha) — set directly, not live-converted, so bKash checkout shows a clean round number
  billingPeriodDays Int @default(30) // 30 = monthly, 365 = annual — activateSubscription extends by this, not a hardcoded month
  active         Boolean @default(true)

  subscriptions Subscription[]
  payments      Payment[]

  @@index([active])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model Subscription {
  id     String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String @db.VarChar(30)
  plan   Plan   @relation(fields: [planId], references: [id])

  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime // quota reverts to free tier if not renewed by this date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([status, currentPeriodEnd])
}

enum BillingProvider {
  BKASH
  NOWPAYMENTS
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid()) @db.VarChar(30)
  subscriptionId String?       @db.VarChar(30) // set once the subscription is created/renewed by this payment
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId         String        @db.VarChar(30)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String        @db.VarChar(30) // the plan this checkout was for — set at creation, before any subscription exists
  plan           Plan          @relation(fields: [planId], references: [id])

  provider    BillingProvider
  providerRef String          @db.VarChar(191) // bKash paymentID, or NOWPayments payment_id
  amount      Int // smallest currency unit (poisha for BDT, cents for USD)
  currency    String          @db.VarChar(10) // "BDT" | "USD"
  status      PaymentStatus   @default(PENDING)
  rawPayload  String?         @db.Text // last known provider response — kept for support/dispute lookup, not parsed at runtime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([userId])
}

// One-time storage top-ups — deliberately NOT modeled as a Plan/Subscription
// (those imply recurring monthly billing via activateSubscription). Kept as
// its own parallel model + its own callback/webhook routes so this is purely
// additive and can't regress the already-built recurring-plan checkout flow.
model AddonPack {
  id             String  @id @db.VarChar(30) // stable slug, e.g. "addon_100gb"
  name           String  @db.VarChar(100)
  bonusBytes     BigInt
  priceUsdCents  Int
  priceBdtPoisha Int
  active         Boolean @default(true)

  purchases AddonPurchase[]

  @@index([active])
}

model AddonPurchase {
  id     String    @id @default(cuid()) @db.VarChar(30)
  userId String    @db.VarChar(30)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId String    @db.VarChar(30)
  pack   AddonPack @relation(fields: [packId], references: [id])

  provider    BillingProvider
  providerRef String          @db.VarChar(191)
  amount      Int
  currency    String          @db.VarChar(10)
  status      PaymentStatus   @default(PENDING)
  rawPayload  String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([userId])
}
